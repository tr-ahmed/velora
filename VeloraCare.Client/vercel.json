{
  "name": "velora-care-client",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://veloracare.runasp.net/api/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "http://veloracare.runasp.net/images/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
